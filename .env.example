# ─────────────────────────────────────────────────────────────────────────────
#  DJ-Cue — local configuration
#
#  Loaded by ./scripts/dev.sh before the backend starts. Restart
#  ./scripts/dev.sh after editing — app/config.py reads these once at boot.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (optional -- has a working default) ─────────────────────────────
# DJ-Cue has no in-memory fallback: every request lives in Postgres so a set
# survives a restart. backend/app/config.py already bakes in the anon key for
# the project this app ships with (safe to be public -- see the comment
# there), so you only need to set these if you're pointing at your *own*
# Supabase project. Get them from Project Settings -> API.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Anti-spam ─────────────────────────────────────────────────────────────────
# Seconds a session must wait between submissions (any song). A session is
# also capped at one contribution to any single song's request_count,
# permanently -- see the submit_song_request migration.
# CUE_SUBMIT_COOLDOWN=2.5

# ── Networking ───────────────────────────────────────────────────────────────
# Override the URL baked into the guest QR code. Auto-detected from the LAN
# IP if unset -- only needed if auto-detection picks the wrong interface.
# CUE_PUBLIC_URL=http://192.168.1.23:3000
