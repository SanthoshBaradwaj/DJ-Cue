# ─────────────────────────────────────────────────────────────────────────────
#  CUE — local configuration
#
#  Loaded by ./scripts/dev.sh before the backend starts. Everything here is
#  optional: with this file empty, CUE runs fully on its deterministic
#  interpreter. Restart ./scripts/dev.sh after editing — the backend reads
#  these once at boot.
# ─────────────────────────────────────────────────────────────────────────────


# ── PASTE YOUR KEY HERE ──────────────────────────────────────────────────────
# Anthropic (get one at https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Or OpenAI instead. If BOTH are set, OpenAI wins — leave this blank to use
# the Anthropic key above.
OPENAI_API_KEY=


# ── Which model interprets requests ──────────────────────────────────────────
# Default: claude-haiku-4-5
#
# Interpretation runs on the ingest path with a hard 2.5s budget, paid on every
# guest submission. The job is a short extraction into a fixed vocabulary, so
# the fastest tier is the right fit — and a model that pauses to think will
# miss the deadline, silently fall back to the rules engine, and cost you money
# for nothing.
#
# For more nuance on messy Hinglish and slang, uncomment one of these AND raise
# the timeout below to ~8s:
#
#   CUE_LLM_MODEL=claude-sonnet-5
#   CUE_LLM_MODEL=claude-opus-5
#
# CUE_LLM_MODEL=claude-haiku-4-5

# How long to wait for the model before giving up and using the rules result.
# A miss is invisible to the guest — they still get an instant ack.
# CUE_LLM_TIMEOUT=2.5

# Kill the LLM layer entirely without removing the key.
# CUE_LLM_ENABLED=false


# ── Tuning (all have sane defaults — see README) ──────────────────────────────
# CUE_CLUSTER_THRESHOLD=0.42   # lower = more, tighter waves
# CUE_MAX_WAVES=5              # hard cap on waves the DJ sees
# CUE_MERGE_FLOOR=0.55         # min similarity to let two clusters merge
# CUE_AUDIO_DIR=audio          # where drop-in MP3s are looked for
# CUE_PUBLIC_URL=              # override the URL encoded in the guest QR
