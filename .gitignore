# ── Secrets ───────────────────────────────────────────────────────────────
# .env holds live Supabase credentials. Never commit it. .env.example is the
# template that IS committed, so the ignore has to be selective rather than
# blanket.
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ── Node / Next ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ── Editor / OS ───────────────────────────────────────────────────────────
.DS_Store
.idea/
*.swp
.claude/settings.local.json
